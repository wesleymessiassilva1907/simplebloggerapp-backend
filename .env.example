# ========================
# Vertix - Environment
# ========================

# General
NODE_ENV=development
TZ=America/Sao_Paulo

# Backend
BACKEND_PORT=3001
JWT_SECRET=vertix-dev-jwt-secret-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
BCRYPT_ROUNDS=10

# Database
DATABASE_URL=postgresql://vertix:vertix_dev_pass@postgres:5432/vertix?schema=public
POSTGRES_USER=vertix
POSTGRES_PASSWORD=vertix_dev_pass
POSTGRES_DB=vertix
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=vertix_minio
MINIO_ROOT_PASSWORD=vertix_minio_secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=vertix-uploads
MINIO_ACCESS_KEY=vertix_minio
MINIO_SECRET_KEY=vertix_minio_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME=Vertix
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Nginx
NGINX_PORT=8080

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3002
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Email (future)
SMTP_HOST=
SMTP_PORT=

# Mailhog (local development email)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vertix.com

# Stripe (future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI (future)
AI_PROVIDER=mock
AI_API_KEY=
