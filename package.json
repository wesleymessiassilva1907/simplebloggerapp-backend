{
  "name": "vertix",
  "version": "1.0.0",
  "private": true,
  "description": "Vertix - SaaS Multi-Vertical Platform (Clinic + Construction)",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:backend": "cd apps/backend && npm run start:dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build": "docker compose build",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "test": "cd apps/backend && npm run test",
    "lint": "cd apps/backend && npm run lint",
    "prisma:migrate": "cd apps/backend && npx prisma migrate dev",
    "prisma:seed": "cd apps/backend && npx prisma db seed",
    "prisma:studio": "cd apps/backend && npx prisma studio",
    "setup": "bash scripts/setup.sh"
  }
}
